   "updated": 1,
   "link": null,
   "locked": false,
   "text": "阻断只针对「未注册 op」。已注册但含 measured / assumed 量的 ⇒ 放行，并在报告里逐项标注 —— 这两件事必须分开，",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "start",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "阻断只针对「未注册 op」。已注册但含 measured / assumed 量的 ⇒ 放行，并在报告里逐项标注 —— 这两件事必须分开，",
   "lineHeight": 1.3
  },
