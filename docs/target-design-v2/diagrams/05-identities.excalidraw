   "link": null,
   "locked": false,
   "text": "x = f(a)            → TensorId t1, StorageId s1\ny = x.view(...)     → TensorId t2, StorageId s1（alias，零 Allocate）\nx = g(y)            → TensorId t3, StorageId s2（同名，但是新逻辑值）",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "start",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "x = f(a)            → TensorId t1, StorageId s1\ny = x.view(...)     → TensorId t2, StorageId s1（alias，零 Allocate）\nx = g(y)            → TensorId t3, StorageId s2（同名，但是新逻辑值）",
   "lineHeight": 1.3
  },
  {
   "id": "d5-t14",
   "type": "text",
   "x": 70.0,
   "y": 620.0,
   "width": 340.0,
   "height": 18.2,
   "angle": 0,
   "strokeColor": "#868e96",
